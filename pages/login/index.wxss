/* ===== 页面基础 ===== */
page {
  background: linear-gradient(180deg, #1a6fe8 0%, #5b9cf5 40%, #f2f3f7 40%);
  font-size: 28rpx;
  color: #1a1a2e;
  min-height: 100vh;
}

.page-login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

/* ===== 品牌区 ===== */
.login-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.login-logo {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.1);
}

.login-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,.85);
  margin-top: 8rpx;
  display: block;
}

/* ===== 登录卡片 ===== */
.login-card {
  width: 650rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 0 0 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,.08);
}

/* ===== Tab ===== */
.login-tabs {
  display: flex;
  border-bottom: 2rpx solid #f0f0f5;
}

.login-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #7c7c9a;
  position: relative;
  transition: color .2s;
}

.login-tab--active {
  color: #1a6fe8;
  font-weight: 700;
}

.login-tab--active::after {
  content: "";
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #1a6fe8;
  border-radius: 2rpx;
}

/* ===== 面板 ===== */
.login-panel {
  padding: 40rpx 48rpx 24rpx;
}

/* ===== 微信登录区 ===== */
.login-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin: 0 auto 16rpx;
  overflow: hidden;
  border: 4rpx solid #ebf3fd;
  box-shadow: 0 4rpx 16rpx rgba(26,111,232,.15);
}

.login-avatar__img {
  width: 100%;
  height: 100%;
  background: #f8f9fb;
}

.login-nickname {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 32rpx;
}

.login-nickname--placeholder {
  color: #b0b0c3;
  font-weight: 400;
  font-size: 26rpx;
}

/* ===== 登录按钮 ===== */
.login-btn {
  width: 100%;
  border-radius: 999rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.login-btn:active {
  transform: scale(.97);
  opacity: .9;
}

.login-btn__icon {
  font-size: 36rpx;
}

.login-btn--wechat {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(7,193,96,.25);
}

.login-btn--phone {
  background: #fff;
  color: #1a6fe8;
  border: 2rpx solid #1a6fe8;
}

.login-btn--primary {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(26,111,232,.25);
}

/* ===== 表单 ===== */
.form-section {
  margin-bottom: 28rpx;
  position: relative;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  color: #3d3d5c;
}

.form-input {
  background: #f8f9fb;
  border-radius: 14rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  width: 100%;
  height: 88rpx;
  line-height: 40rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: border-color .15s;
}

.form-input:focus {
  border-color: #85b8f8;
  box-shadow: 0 0 0 4rpx rgba(26,111,232,.06);
}

.form-input--icon {
  padding-left: 72rpx;
}

.form-input--sms {
  padding-right: 190rpx;
}

.form-input-icon {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(6rpx);
  font-size: 34rpx;
  pointer-events: none;
}

.form-pwd-toggle {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(4rpx);
  font-size: 36rpx;
  padding: 8rpx;
}

.form-sms-btn {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(4rpx);
  background: #ebf3fd;
  color: #1a6fe8;
  font-size: 24rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.form-sms-btn--disabled {
  background: #f0f0f5;
  color: #b0b0c3;
}

/* ===== 分割线 ===== */
.login-divider {
  display: flex;
  align-items: center;
  margin: 24rpx 0;
}

.login-divider__line {
  flex: 1;
  height: 1rpx;
  background: #e4e7ed;
}

.login-divider__text {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #b0b0c3;
}

/* ===== 切换链接 ===== */
.login-switch-link {
  text-align: center;
  padding: 8rpx;
}

.login-switch-link text {
  font-size: 26rpx;
  color: #1a6fe8;
}

/* ===== 额外链接 ===== */
.login-extra {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.login-extra__link {
  font-size: 24rpx;
  color: #7c7c9a;
}

/* ===== 底部 ===== */
.login-footer {
  text-align: center;
  padding: 40rpx 0;
  margin-top: auto;
}

.login-footer__text {
  font-size: 22rpx;
  color: #b0b0c3;
}

.login-footer__link {
  font-size: 22rpx;
  color: #1a6fe8;
}
