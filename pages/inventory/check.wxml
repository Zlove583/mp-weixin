<view class="page-check data-v-a35f7fee"><view wx:if="{{a}}" class="check-create data-v-a35f7fee"><text class="check-create__title data-v-a35f7fee">创建盘点任务</text><text class="check-create__desc data-v-a35f7fee">对当前库存进行全面盘点，系统将对比账面数与实盘数，自动生成盘盈盘亏报告</text><view class="form-section data-v-a35f7fee"><text class="form-label data-v-a35f7fee">盘点范围</text><picker class="data-v-a35f7fee" range="{{c}}" bindchange="{{d}}"><view class="form-picker data-v-a35f7fee">{{b}} ›</view></picker></view><view wx:if="{{e}}" class="form-section data-v-a35f7fee"><text class="form-label data-v-a35f7fee">选择分类</text><picker class="data-v-a35f7fee" range="{{g}}" bindchange="{{h}}"><view class="form-picker data-v-a35f7fee">{{f}} ›</view></picker></view><button class="btn-start data-v-a35f7fee" bindtap="{{i}}">开始盘点</button></view><view wx:else class="check-progress data-v-a35f7fee"><view class="check-progress__header data-v-a35f7fee"><text class="check-progress__title data-v-a35f7fee">盘点进行中</text><text class="check-progress__count data-v-a35f7fee">{{j}}/{{k}} 项</text></view><view class="check-progress__bar data-v-a35f7fee"><view class="check-progress__fill data-v-a35f7fee" style="{{'width:' + l}}"></view></view><view class="check-list data-v-a35f7fee"><view wx:for="{{m}}" wx:for-item="item" wx:key="l" class="check-item data-v-a35f7fee"><view class="check-item__info data-v-a35f7fee"><text class="check-item__name data-v-a35f7fee">{{item.a}}</text><text class="check-item__code data-v-a35f7fee">{{item.b}} · 账面: {{item.c}}{{item.d}}</text></view><view class="check-item__input data-v-a35f7fee"><input type="number" placeholder="实盘数" class="{{['check-input', 'data-v-a35f7fee', item.e && 'diff']}}" value="{{item.f}}" bindinput="{{item.g}}"/><text class="check-item__unit data-v-a35f7fee">{{item.h}}</text></view><view wx:if="{{item.i}}" class="check-item__diff data-v-a35f7fee">{{item.j}} {{item.k}}</view></view></view><button class="btn-submit data-v-a35f7fee" bindtap="{{n}}">提交盘点结果</button></view></view>