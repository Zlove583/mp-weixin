/**
 * OCR 票据识别页面样式
 */

/* ── 页面基础 ── */
page {
  background-color: #f2f3f7;
  color: #1a1a2e;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page-ocr {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
}

.safe-bottom {
  height: 60rpx;
}

/* ── 票据类型选择栏 ── */
.doc-type-bar {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin: 16rpx 0 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}

.doc-type-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 14rpx;
  transition: all 0.25s ease;
}

.doc-type-tab--active {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  box-shadow: 0 4rpx 16rpx rgba(26,111,232,.2);
}

.doc-type-tab--active .doc-type-label {
  color: #fff;
}

.doc-type-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.doc-type-label {
  font-size: 22rpx;
  color: #7c7c9a;
  font-weight: 500;
}

/* ── 提示文字 ── */
.ocr-tips {
  background: #fff8e1;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #8d6e03;
  line-height: 1.6;
}

/* ── 图片预览区 ── */
.ocr-preview {
  margin-bottom: 20rpx;
}

.ocr-placeholder {
  background: #fff;
  border: 3rpx dashed #d0d0dd;
  border-radius: 24rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  transition: border-color .2s;
}

.ocr-placeholder:active {
  border-color: #85b8f8;
  background: #f5f9fe;
}

.ocr-placeholder__icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 12rpx;
}

.ocr-placeholder__text {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.ocr-placeholder__sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.ocr-image-wrap {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
}

.ocr-image {
  width: 100%;
  display: block;
  border-radius: 20rpx;
}

.ocr-image-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,.4));
  padding: 40rpx 24rpx 20rpx;
  text-align: center;
  color: #fff;
  font-size: 24rpx;
}

/* ── 操作按钮 ── */
.ocr-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ocr-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: transform .15s;
}

.ocr-btn:active {
  transform: scale(.97);
}

.ocr-btn--primary {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(26,111,232,.25);
}

.ocr-btn--ghost {
  background: #fff;
  color: #1a6fe8;
  border: 2rpx solid #1a6fe8;
}

/* ── 识别加载 ── */
.ocr-loading {
  text-align: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 24rpx;
  border: 6rpx solid #e8edf5;
  border-top-color: #1a6fe8;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.loading-sub {
  font-size: 24rpx;
  color: #999;
}

/* ── 识别结果标题 ── */
.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #e8f4fd, #f0f7ff);
  border-radius: 16rpx;
  border-left: 6rpx solid #1a6fe8;
}

.result-header__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-doctype {
  font-size: 32rpx;
  font-weight: 700;
}

.result-confidence {
  font-size: 22rpx;
  color: #07c160;
  background: #e6f9ef;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.result-header__right {
  font-size: 24rpx;
  color: #1a6fe8;
}

.result-rescan {
  padding: 8rpx 16rpx;
  border: 1rpx solid #1a6fe8;
  border-radius: 999rpx;
}

/* ── 字段分组 ── */
.result-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.result-group {
  animation: fadeUp .4s ease both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #7c7c9a;
  padding: 0 8rpx 10rpx;
  display: block;
  letter-spacing: 1rpx;
}

.field-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 4rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}

.field-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f7;
  transition: background .15s;
}

.field-row:last-child {
  border-bottom: none;
}

.field-row--editing {
  background: #fefce8;
}

.field-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.field-icon {
  font-size: 26rpx;
  width: 36rpx;
  text-align: center;
}

.field-label {
  font-size: 26rpx;
  color: #666;
}

.field-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 20rpx;
  flex: 1;
  justify-content: flex-end;
}

.field-value {
  font-size: 28rpx;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.field-value--money {
  font-weight: 700;
  color: #1a6fe8;
}

.field-value--empty {
  color: #ccc;
  font-weight: 400;
}

.field-edit-btn {
  font-size: 28rpx;
  opacity: .5;
  flex-shrink: 0;
  padding: 4rpx;
}

/* ── 字段编辑 ── */
.field-edit {
  flex: 1;
  margin-left: 20rpx;
}

.field-input {
  width: 100%;
  text-align: right;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #1a6fe8;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  background: #fff;
}

/* ── 结果操作按钮 ── */
.result-actions {
  margin-bottom: 32rpx;
}

.action-btn {
  width: 100%;
  padding: 22rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: transform .15s;
}

.action-btn:active {
  transform: scale(.97);
}

.action-btn--primary {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(26,111,232,.25);
}

/* ── 凭证预览 ── */
.voucher-preview {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,.06);
}

.voucher-title {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 20rpx;
}

.voucher-card {
  background: #f5f9fe;
  border-radius: 14rpx;
  padding: 24rpx;
  border-left: 6rpx solid #1a6fe8;
  margin-bottom: 24rpx;
}

.voucher-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  line-height: 1.6;
}

.voucher-summary {
  font-size: 28rpx;
  font-weight: 500;
}

.voucher-amount {
  font-size: 36rpx;
  font-weight: 700;
}

.voucher-subject {
  font-size: 26rpx;
  color: #666;
}

.voucher-cancel {
  display: block;
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 16rpx;
  padding: 12rpx;
}

/* ── 历史记录 ── */
.history-section {
  margin-top: 8rpx;
}

.history-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.history-header__title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.history-header__count {
  font-size: 24rpx;
  color: #999;
}

.history-header__arrow {
  font-size: 32rpx;
  color: #999;
  transition: transform .2s;
}

.history-header__arrow.arrow-up {
  transform: rotate(90deg);
}

.history-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f2f3f7;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item__type {
  font-size: 28rpx;
  font-weight: 500;
  display: block;
}

.history-item__date {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.history-item__right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-item__amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a6fe8;
}

.history-item__del {
  font-size: 32rpx;
  padding: 8rpx;
}

.history-empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* ── 通用 ── */
.text-success { color: #07c160; }
.text-danger { color: #fa5151; }

/* ── 数据来源标签 ── */
.result-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 8rpx;
}
.badge-cloud { background: #d4f5e0; color: #07c160; }
.badge-mock  { background: #fff3cd; color: #b06000; }

/* ── 错误提示（旧版，保留兼容） ── */
.ocr-error-tip {
  background: #fff3cd;
  border: 1rpx solid #ffc107;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #856404;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* ── 识别失败错误面板 ── */
.ocr-error-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,.06);
  text-align: center;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-content {
  margin-bottom: 32rpx;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fa5151;
  margin-bottom: 12rpx;
}

.error-message {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
  padding: 0 16rpx;
}

.error-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  padding: 0 16rpx;
}

.error-actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.error-actions .ocr-btn {
  flex: 1;
}
