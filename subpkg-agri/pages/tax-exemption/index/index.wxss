/**
 * 免税核算申报页样式
 */

page {
  background-color: #f2f3f7;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page-tax-exemption {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 头部 ===== */
.tax-header {
  background: linear-gradient(135deg, #07c160, #2ddb7a);
  padding: 36rpx 24rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.tax-header__bg {
  position: absolute;
  right: -50rpx;
  top: -30rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.06);
}

.tax-header__title {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  position: relative;
  z-index: 1;
}

.tax-header__desc {
  font-size: 24rpx;
  color: rgba(255,255,255,.85);
  margin-top: 8rpx;
  display: block;
  position: relative;
  z-index: 1;
  line-height: 1.5;
}

/* ===== 核算表单 ===== */
.calc-form {
  padding: 24rpx;
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.05);
}

.form-section {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #1a1a2e;
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.picker-arrow {
  font-size: 32rpx;
  color: #b0b0c3;
}

.type-row {
  display: flex;
  gap: 12rpx;
}

.type-opt {
  flex: 1;
  text-align: center;
  padding: 14rpx 16rpx;
  background: #f8f9fb;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #7c7c9a;
  border: 2rpx solid transparent;
  transition: all .2s ease;
}

.type-opt--active {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
  font-weight: 600;
}

.calc-btn {
  width: 100%;
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  border-radius: 999rpx;
  padding: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 0 24rpx rgba(7,193,96,.25);
  margin-top: 12rpx;
}

.calc-btn:active {
  transform: scale(.98);
}

/* ===== 核算结果摘要 ===== */
.result-summary {
  display: flex;
  margin: 16rpx 24rpx;
  gap: 12rpx;
}

.result-summary__item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}

.result-summary__item--sales {
  border-top: 4rpx solid #1a6fe8;
}

.result-summary__item--exemption {
  border-top: 4rpx solid #07c160;
}

.result-summary__item--saved {
  border-top: 4rpx solid #ff9500;
}

.result-summary__value {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  color: #1a1a2e;
}

.result-summary__label {
  font-size: 20rpx;
  color: #7c7c9a;
  display: block;
  margin-top: 4rpx;
}

/* ===== 核算明细 ===== */
.result-detail__row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}

.result-detail__row--final {
  padding: 20rpx 16rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.result-detail__label {
  color: #7c7c9a;
}

.result-detail__value {
  font-weight: 500;
}

.result-detail__divider {
  height: 1rpx;
  background: #e4e7ed;
  margin: 4rpx 0;
}

/* ===== 适用规则 ===== */
.applied-rule {
  padding: 16rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  border-left: 6rpx solid #07c160;
}

.applied-rule:last-child {
  margin-bottom: 0;
}

.applied-rule__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.applied-rule__code {
  font-size: 24rpx;
  color: #1a6fe8;
  font-weight: 600;
}

.applied-rule__rate {
  font-size: 22rpx;
  background: #e8f8ee;
  color: #07c160;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.applied-rule__name {
  font-weight: 600;
  display: block;
  font-size: 26rpx;
}

.applied-rule__amount {
  font-size: 24rpx;
  color: #07c160;
  font-weight: 600;
  display: block;
  margin-top: 4rpx;
}

.applied-rule__basis {
  font-size: 22rpx;
  color: #b0b0c3;
  display: block;
  margin-top: 4rpx;
}

/* ===== 操作按钮 ===== */
.result-actions {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.agri-btn {
  width: 100%;
  border-radius: 999rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.agri-btn:active {
  transform: scale(.98);
}

.agri-btn--primary {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
}

.agri-btn--success {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
}

.agri-btn--secondary {
  background: #fff;
  color: #1a6fe8;
  border: 2rpx solid #1a6fe8;
}

/* ===== 额度进度条 ===== */
.quota-bar {
  padding: 8rpx 0;
}

.quota-bar__header {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #7c7c9a;
  margin-bottom: 10rpx;
}

.quota-bar__track {
  height: 16rpx;
  background: #e4e7ed;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.quota-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #2ddb7a);
  border-radius: 8rpx;
  transition: width .4s ease;
}

.quota-bar__remaining {
  font-size: 24rpx;
  color: #7c7c9a;
}

/* ===== 通用 ===== */
.agri-safe-bottom { height: 40rpx; }
.fw-600 { font-weight: 600; }
.fw-700 { font-weight: 700; }
.text-success { color: #07c160; }
.text-warning { color: #ff9500; }
.text-danger  { color: #fa5151; }
