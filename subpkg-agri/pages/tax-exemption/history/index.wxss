/**
 * 免税核算历史记录页样式
 */

page {
  background-color: #f2f3f7;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page-tax-history {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 筛选区 ===== */
.history-filter {
  background: #fff;
  padding: 16rpx 24rpx;
  margin-bottom: 12rpx;
}

.history-filter__picker {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f8f9fb;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.picker-arrow {
  font-size: 24rpx;
  color: #b0b0c3;
}

.filter-tabs {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.filter-tab {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  background: #f8f9fb;
  border-radius: 999rpx;
  color: #7c7c9a;
  transition: all .2s ease;
}

.filter-tab--active {
  background: #1a6fe8;
  color: #fff;
  font-weight: 600;
}

/* ===== 汇总条 ===== */
.history-summary {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #7c7c9a;
}

/* ===== 空状态 ===== */
.agri-empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.agri-empty__icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.agri-empty__text {
  font-size: 28rpx;
  color: #7c7c9a;
  display: block;
  margin-bottom: 24rpx;
}

.agri-btn {
  width: 100%;
  border-radius: 999rpx;
  padding: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.agri-btn:active {
  transform: scale(.98);
}

.agri-btn--primary {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
}

.agri-btn--sm {
  width: auto;
  display: inline-block;
  padding: 14rpx 48rpx;
  font-size: 26rpx;
}

/* ===== 记录卡片 ===== */
.record-list {
  padding: 0 24rpx;
}

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}

.record-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f5;
}

.record-card__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-card__no {
  font-size: 24rpx;
  color: #1a6fe8;
  font-weight: 600;
}

.record-card__period {
  font-size: 24rpx;
  color: #7c7c9a;
}

.record-card__status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.record-card__status--draft {
  background: #f0f0f5;
  color: #7c7c9a;
}

.record-card__status--confirmed {
  background: #e8f8ee;
  color: #07c160;
}

.record-card__status--declared {
  background: #ebf3fd;
  color: #1a6fe8;
}

.record-card__body {
  display: flex;
  flex-wrap: wrap;
}

.record-card__item {
  width: 50%;
  padding: 6rpx 0;
}

.record-card__label {
  font-size: 22rpx;
  color: #7c7c9a;
  display: block;
}

.record-card__value {
  font-size: 26rpx;
  font-weight: 500;
}

.record-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f5;
}

.record-card__date {
  font-size: 22rpx;
  color: #b0b0c3;
}

.record-card__arrow {
  font-size: 24rpx;
  color: #1a6fe8;
}

/* ===== 加载 ===== */
.loading-wrap { padding: 24rpx; }
.skeleton {
  background: linear-gradient(90deg, #e4e7ed 25%, #f2f3f7, #e4e7ed 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 12rpx;
}
@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* ===== 通用 ===== */
.agri-safe-bottom { height: 40rpx; }
.fw-600 { font-weight: 600; }
.text-success { color: #07c160; }
.text-warning { color: #ff9500; }
.text-danger  { color: #fa5151; }
