/**
 * 北疆农牧数字化 - 首页样式
 * 沿用项目主色调 #1A6FE8，统一的卡片/按钮/排版风格
 */

/* ===== 页面基础 ===== */
page {
  background-color: #f2f3f7;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page-agri {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ===== 头部 ===== */
.agri-header {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  padding: 32rpx 24rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.agri-header__bg {
  position: absolute;
  right: -60rpx;
  top: -40rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.06);
}

.agri-header__content {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
}

.agri-header__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  letter-spacing: 1rpx;
}

.agri-header__subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,.8);
  margin-top: 6rpx;
  display: block;
}

/* ===== 统计卡片 ===== */
.agri-stats {
  display: flex;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.agri-stat {
  text-align: center;
  flex: 1;
}

.agri-stat__value {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.12);
}

.agri-stat__label {
  font-size: 22rpx;
  color: rgba(255,255,255,.85);
  margin-top: 4rpx;
}

/* ===== 功能入口 ===== */
.agri-entries {
  margin: -24rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
}

.agri-entry {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.06);
  transition: transform .15s ease;
}

.agri-entry:active {
  transform: scale(.98);
}

.agri-entry__icon {
  font-size: 52rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.agri-entry--livestock .agri-entry__icon {
  background: #e8f8ee;
}

.agri-entry--tax .agri-entry__icon {
  background: #ebf3fd;
}

.agri-entry__info {
  flex: 1;
}

.agri-entry__title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  color: #1a1a2e;
}

.agri-entry__desc {
  font-size: 24rpx;
  color: #7c7c9a;
  margin-top: 4rpx;
  display: block;
}

.agri-entry__tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.agri-entry__tag {
  font-size: 20rpx;
  color: #1a6fe8;
  background: #ebf3fd;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.agri-entry__arrow {
  font-size: 36rpx;
  color: #c0c0d0;
  font-weight: 300;
}

/* ===== 种类分布 ===== */
.category-item {
  margin-bottom: 16rpx;
}

.category-item:last-child {
  margin-bottom: 0;
}

.category-item__header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.category-item__name {
  font-weight: 600;
  font-size: 26rpx;
}

.category-item__count {
  font-size: 26rpx;
  color: #1a6fe8;
  font-weight: 600;
}

.category-item__bar {
  height: 12rpx;
  background: #e4e7ed;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 4rpx;
}

.category-item__fill {
  height: 100%;
  background: linear-gradient(90deg, #1a6fe8, #5b9cf5);
  border-radius: 6rpx;
  transition: width .4s ease;
}

.category-item__value {
  font-size: 22rpx;
  color: #7c7c9a;
}

/* ===== 时间线 ===== */
.timeline-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  position: relative;
}

.timeline-item:not(:last-child):after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 36rpx;
  bottom: -2rpx;
  width: 2rpx;
  background: #e4e7ed;
}

.timeline-item__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.timeline-item__dot--alive {
  background: #07c160;
}

.timeline-item__dot--sold {
  background: #ff9500;
}

.timeline-item__dot--dead {
  background: #fa5151;
}

.timeline-item__content {
  flex: 1;
}

/* ===== 快速操作 ===== */
.agri-quick-actions {
  padding: 0 24rpx;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.agri-btn {
  flex: 1;
  border-radius: 999rpx;
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  transition: transform .15s ease;
}

.agri-btn:active {
  transform: scale(.97);
}

.agri-btn--primary {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
  box-shadow: 0 0 20rpx rgba(26,111,232,.2);
}

.agri-btn--secondary {
  background: #fff;
  color: #1a6fe8;
  border: 2rpx solid #1a6fe8;
}

.agri-btn--success {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
}

.agri-btn--warning {
  background: linear-gradient(135deg, #ff9500, #ffb340);
  color: #fff;
}

.agri-btn--danger {
  background: #fa5151;
  color: #fff;
}

.agri-btn--danger-outline {
  background: #fff;
  color: #fa5151;
  border: 2rpx solid #fa5151;
}

.agri-btn--sm {
  flex: none;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
}

/* ===== 政策速递 ===== */
.policy-item {
  display: flex;
  gap: 10rpx;
  padding: 10rpx 0;
  align-items: flex-start;
}

.policy-item:not(:last-child) {
  border-bottom: 1rpx solid #f0f0f5;
}

.policy-item__dot {
  color: #07c160;
  font-weight: 700;
  flex-shrink: 0;
}

.policy-item__text {
  font-size: 24rpx;
  color: #3d3d5c;
  line-height: 1.6;
}

/* ===== 通用 ===== */
.agri-safe-bottom {
  height: 40rpx;
}

.fw-600 {
  font-weight: 600;
}

.fw-700 {
  font-weight: 700;
}

.text-success { color: #07c160; }
.text-warning { color: #ff9500; }
.text-danger  { color: #fa5151; }
.text-secondary { color: #7c7c9a; }

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.font-sm {
  font-size: 24rpx;
}
