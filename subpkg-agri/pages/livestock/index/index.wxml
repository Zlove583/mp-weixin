<!--
  牲畜存栏台账列表页
  支持搜索、种类筛选、状态筛选、分页
-->
<view class="page-livestock-list">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input class="search-bar__input" placeholder="搜索编号/品种/来源..." value="{{keyword}}" bindinput="onSearchInput" confirm-type="search"/>
    <text class="search-bar__icon">🔍</text>
  </view>

  <!-- 筛选标签 -->
  <scroll-view class="filter-tabs" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
    <!-- 种类筛选 -->
    <view class="filter-tabs__group">
      <text class="filter-tabs__label">种类</text>
      <view class="filter-tab {{activeCategory === '' ? 'filter-tab--active' : ''}}" bindtap="onFilterCategory" data-category="">全部</view>
      <view class="filter-tab {{activeCategory === cat ? 'filter-tab--active' : ''}}" wx:for="{{categories}}" wx:key="*this" bindtap="onFilterCategory" data-category="{{item}}">{{item}}</view>
    </view>
    <!-- 状态筛选 -->
    <view class="filter-tabs__group">
      <text class="filter-tabs__label">状态</text>
      <view class="filter-tab {{activeStatus === '' ? 'filter-tab--active' : ''}}" bindtap="onFilterStatus" data-status="">全部</view>
      <view class="filter-tab filter-tab--{{item === '存栏' ? 'alive' : item === '出栏' ? 'sold' : item === '死亡' ? 'dead' : ''}} {{activeStatus === item ? 'filter-tab--active' : ''}}" wx:for="{{statuses}}" wx:key="*this" bindtap="onFilterStatus" data-status="{{item}}">{{item}}</view>
    </view>
  </scroll-view>

  <!-- 汇总条 -->
  <view class="summary-bar" wx:if="{{!loading}}">
    <text class="summary-bar__text">共 <text class="fw-600">{{filteredTotal}}</text> 条记录</text>
    <text class="summary-bar__text">存栏 <text class="text-success fw-600">{{summary.aliveCount}}</text> · 出栏 <text class="text-warning fw-600">{{summary.soldCount}}</text> · 死亡 <text class="text-danger fw-600">{{summary.deadCount}}</text></text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="skeleton" style="height:160rpx;margin-bottom:16rpx;" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <!-- 空状态 -->
  <z-empty wx:if="{{!loading && filteredList.length === 0}}" title="暂无牲畜台账" description="点击下方按钮新增第一条台账记录" show-btn="{{true}}" btn-text="新增台账" bind:action="goAdd"></z-empty>

  <!-- 台账列表 -->
  <view class="livestock-list" wx:if="{{!loading && filteredList.length > 0}}">
    <view class="livestock-card {{item.currentStatus === '死亡' ? 'livestock-card--dead' : ''}}" wx:for="{{pagedList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <!-- 左侧状态指示条 -->
      <view class="livestock-card__indicator livestock-card__indicator--{{item.currentStatus === '存栏' ? 'alive' : item.currentStatus === '出栏' ? 'sold' : 'dead'}}"></view>
      <view class="livestock-card__body">
        <view class="livestock-card__header">
          <view class="livestock-card__title-row">
            <text class="livestock-card__name">{{item.breed || item.category}}</text>
            <text class="livestock-card__no">{{item.livestockNo}}</text>
          </view>
          <view class="livestock-card__status livestock-card__status--{{item.currentStatus === '存栏' ? 'alive' : item.currentStatus === '出栏' ? 'sold' : 'dead'}}">{{item.currentStatus}}</view>
        </view>
        <view class="livestock-card__info">
          <text class="livestock-card__info-item">种类：{{item.category}}</text>
          <text class="livestock-card__info-item">{{item.gender === 0 ? '母' : '公'}} · {{item.weightKg ? item.weightKg + 'kg' : '未知体重'}}</text>
          <text class="livestock-card__info-item">来源：{{item.source}}</text>
        </view>
        <view class="livestock-card__footer">
          <text class="livestock-card__price" wx:if="{{item.purchasePrice > 0}}">购入成本：¥{{item.purchasePrice}}</text>
          <text class="livestock-card__price livestock-card__price--sale" wx:if="{{item.salePrice > 0}}">出栏售价：¥{{item.salePrice}}</text>
          <text class="livestock-card__date">{{item.updatedAt}}</text>
        </view>
        <!-- 死亡标记 -->
        <view class="livestock-card__death" wx:if="{{item.currentStatus === '死亡' && item.deathCause}}">
          <text>死因：{{item.deathCause}}</text>
        </view>
      </view>
      <text class="livestock-card__arrow">›</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <text class="load-more__text" bindtap="loadMore">加载更多</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && filteredList.length > 0}}">
      <text class="load-more__text load-more__text--end">— 已加载全部 —</text>
    </view>
  </view>

  <!-- 底部新增按钮 -->
  <view class="fab" bindtap="goAdd">
    <text class="fab__icon">+</text>
  </view>

  <view class="agri-safe-bottom"></view>
</view>
