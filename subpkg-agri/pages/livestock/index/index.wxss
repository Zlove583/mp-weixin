/**
 * 牲畜存栏台账列表页
 * 搜索 + 筛选标签 + 卡片列表
 */

page {
  background-color: #f2f3f7;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page-livestock-list {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  position: relative;
  margin: 16rpx 24rpx;
}

.search-bar__input {
  background: #fff;
  border-radius: 999rpx;
  padding: 16rpx 24rpx 16rpx 64rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}

.search-bar__icon {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
}

/* ===== 筛选标签 ===== */
.filter-tabs {
  white-space: nowrap;
  padding: 12rpx 24rpx;
}

.filter-tabs__group {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 32rpx;
}

.filter-tabs__label {
  font-size: 24rpx;
  color: #7c7c9a;
  font-weight: 600;
  margin-right: 4rpx;
}

.filter-tab {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  background: #fff;
  border-radius: 999rpx;
  color: #7c7c9a;
  transition: all .2s ease;
}

.filter-tab--active {
  background: #1a6fe8;
  color: #fff;
  font-weight: 600;
}

/* ===== 汇总条 ===== */
.summary-bar {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #7c7c9a;
}

/* ===== 台账卡片 ===== */
.livestock-list {
  padding: 0 24rpx;
}

.livestock-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
  overflow: hidden;
  transition: transform .15s ease;
}

.livestock-card:active {
  transform: scale(.99);
}

.livestock-card--dead {
  opacity: .7;
}

.livestock-card__indicator {
  width: 6rpx;
  flex-shrink: 0;
}

.livestock-card__indicator--alive {
  background: #07c160;
}

.livestock-card__indicator--sold {
  background: #ff9500;
}

.livestock-card__indicator--dead {
  background: #c0c0d0;
}

.livestock-card__body {
  flex: 1;
  padding: 18rpx 20rpx;
}

.livestock-card__header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.livestock-card__title-row {
  flex: 1;
}

.livestock-card__name {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
}

.livestock-card__no {
  font-size: 22rpx;
  color: #7c7c9a;
}

.livestock-card__status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.livestock-card__status--alive {
  background: #e8f8ee;
  color: #07c160;
}

.livestock-card__status--sold {
  background: #fff4e5;
  color: #ff9500;
}

.livestock-card__status--dead {
  background: #fff0f0;
  color: #fa5151;
}

.livestock-card__info {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 20rpx;
  margin-bottom: 8rpx;
}

.livestock-card__info-item {
  font-size: 24rpx;
  color: #7c7c9a;
}

.livestock-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.livestock-card__price {
  font-size: 24rpx;
  color: #ff9500;
  font-weight: 600;
}

.livestock-card__price--sale {
  color: #07c160;
}

.livestock-card__date {
  font-size: 22rpx;
  color: #b0b0c3;
}

.livestock-card__death {
  background: #fff0f0;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #fa5151;
}

.livestock-card__arrow {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  font-size: 32rpx;
  color: #c0c0d0;
}

/* ===== 加载更多 ===== */
.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more__text {
  font-size: 24rpx;
  color: #1a6fe8;
}

.load-more__text--end {
  color: #b0b0c3;
}

/* ===== FAB ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26,111,232,.35);
  z-index: 10;
  transition: transform .15s ease;
}

.fab:active {
  transform: scale(.92);
}

.fab__icon {
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
}

/* ===== 骨架 ===== */
.loading-wrap {
  padding: 24rpx;
}

.skeleton {
  background: linear-gradient(90deg, #e4e7ed 25%, #f2f3f7, #e4e7ed 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 12rpx;
}

@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* ===== 通用 ===== */
.agri-safe-bottom { height: 40rpx; }
.fw-600 { font-weight: 600; }
.text-success { color: #07c160; }
.text-warning { color: #ff9500; }
.text-danger  { color: #fa5151; }
