/**
 * 牲畜详情页样式
 */

page {
  background-color: #f2f3f7;
  font-size: 28rpx;
  color: #1a1a2e;
}

.page-livestock-detail {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* ===== 状态头部 ===== */
.detail-header {
  padding: 40rpx 24rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.detail-header::after {
  content: "";
  position: absolute;
  right: -40rpx;
  top: -30rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
}

.detail-header--alive {
  background: linear-gradient(135deg, #07c160, #2ddb7a);
}

.detail-header--sold {
  background: linear-gradient(135deg, #ff9500, #ffb340);
}

.detail-header--dead {
  background: linear-gradient(135deg, #7c7c9a, #a0a0b8);
}

.detail-header__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.detail-header__name {
  font-size: 40rpx;
  font-weight: 700;
}

.detail-header__status {
  font-size: 24rpx;
  background: rgba(255,255,255,.25);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(10rpx);
}

.detail-header__no {
  font-size: 26rpx;
  opacity: .85;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
  display: block;
}

/* ===== 信息网格 ===== */
.detail-grid {
  display: flex;
  flex-wrap: wrap;
}

.detail-grid__item {
  width: 50%;
  padding: 12rpx 0;
}

.detail-grid__item--full {
  width: 100%;
}

.detail-grid__label {
  font-size: 24rpx;
  color: #7c7c9a;
  display: block;
  margin-bottom: 4rpx;
}

.detail-grid__value {
  font-size: 28rpx;
  font-weight: 500;
}

/* ===== 信息行 ===== */
.detail-info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  align-items: flex-start;
}

.detail-info-row:not(:last-child) {
  border-bottom: 1rpx solid #f0f0f5;
}

.detail-info-row__label {
  font-size: 24rpx;
  color: #7c7c9a;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.detail-info-row__value {
  font-size: 26rpx;
  text-align: right;
  flex: 1;
}

/* ===== 底部操作栏 ===== */
.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06);
  z-index: 10;
}

.detail-actions .agri-btn {
  flex: 1;
  border-radius: 999rpx;
  padding: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.agri-btn--primary {
  background: linear-gradient(135deg, #1a6fe8, #5b9cf5);
  color: #fff;
}

.agri-btn--warning {
  background: linear-gradient(135deg, #ff9500, #ffb340);
  color: #fff;
}

.agri-btn--danger {
  background: #fa5151;
  color: #fff;
}

.agri-btn--danger-outline {
  background: #fff;
  color: #fa5151;
  border: 2rpx solid #fa5151;
}

/* ===== 通用 ===== */
.loading-wrap { padding: 24rpx; }
.skeleton {
  background: linear-gradient(90deg, #e4e7ed 25%, #f2f3f7, #e4e7ed 75%);
  background-size: 800rpx 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 12rpx;
}
@keyframes shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}
.agri-safe-bottom { height: 40rpx; }
.fw-600 { font-weight: 600; }
.text-success { color: #07c160; }
.text-warning { color: #ff9500; }
.text-danger  { color: #fa5151; }
